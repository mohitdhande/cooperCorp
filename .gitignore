# Android/iOS build artifacts — covers every app folder (Cooper,
# Cooper_Dealer, Cooper_AreaManager), not just one. These were previously
# only ignored for Cooper/, which let a stale Gradle cache from a sibling
# app get pulled into an EAS Build archive from a different app folder.
*/android/app/build/
*/android/build/
*/android/.gradle/
*/android/.cxx/
*/android/.kotlin/
*/android/local.properties
*/ios/build/
*/ios/Pods/
*.keystore
*.jks
